# Salin file ini menjadi .env.local lalu isi nilainya.

# Alamat situs setelah online, untuk pratinjau link (WA, dll.). Contoh: https://tanya.naufalhabibi.biz.id
NEXT_PUBLIC_SITE_URL=

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email akun admin (dibuat di Supabase > Authentication > Users > Add user).
# Hanya email ini yang boleh masuk panel admin.
ADMIN_EMAIL=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_CADANGAN=gemini-3.5-flash-lite
